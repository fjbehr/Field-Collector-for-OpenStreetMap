{
  "name": "osm-field-collector",
  "version": "0.2.1",
  "private": true,
  "description": "Field Collector for OpenStreetMap – offline-first Android app to collect OpenStreetMap nodes and ways with GPS",
  "license": "GPL-3.0-or-later",
  "author": "Franz-Josef Behr and contributors",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/make-notices.mjs && vite build",
    "preview": "vite preview",
    "sync": "npm run build && cap sync android",
    "apk": "npm run build && cap sync android && cd android && .\\gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.3.1",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/browser": "^8.0.5",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "capacitor-email-composer": "^8.0.0",
    "fflate": "0.8.3",
    "jsqr": "1.4.0",
    "leaflet": "^1.9.4",
    "lucide": "1.77.0",
    "pmtiles": "^4.5.0",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "sharp": "0.35.5",
    "vite": "^8.3.8"
  }
}
